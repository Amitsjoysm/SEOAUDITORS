# Database Configuration Template
# Copy this to .env and update with your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Connection String Format:
# DATABASE_URL="postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE"

# Example for local PostgreSQL:
DATABASE_URL="postgresql+asyncpg://mjseo_user:your_password_here@localhost:5432/mjseo_db"

# Example for remote PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://username:password@your-server.com:5432/database_name"

# ============================================
# CORS CONFIGURATION
# ============================================

# IMPORTANT: Include BOTH http and https origins for your domain
# Separate multiple origins with commas (no spaces)
CORS_ORIGINS="http://marketautomailer.mj.publicvm.com,https://marketautomailer.mj.publicvm.com"

# For development (allows all origins):
# CORS_ORIGINS="*"

# ============================================
# SECURITY
# ============================================

# Generate a secure random key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-this-to-a-secure-random-key"

# Frontend URL (used for redirects)
FRONTEND_URL="https://marketautomailer.mj.publicvm.com"

# ============================================
# API KEYS
# ============================================

# Groq API (for LLM functionality)
GROQ_API_KEY="your_groq_api_key_here"

# Exa AI (for research functionality)
EXA_API_KEY="your_exa_api_key_here"

# ============================================
# STRIPE CONFIGURATION
# ============================================

# Stripe Secret Key (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Stripe Publishable Key
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Stripe Webhook Secret (create webhook at https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ============================================
# DATAFORSEO CONFIGURATION
# ============================================

# DataForSEO API Credentials (get from https://dataforseo.com)
DATAFORSEO_USERNAME="your_email@example.com"
DATAFORSEO_PASSWORD="your_dataforseo_password"

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================

# Google OAuth Credentials (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_PROJECT_ID="your_google_project_id"

# ============================================
# PRODUCTION SECURITY HEADERS
# ============================================

# Enable HSTS (HTTP Strict Transport Security)
# Set to "true" only if you have valid HTTPS
ENABLE_HSTS="false"

# Enable Content Security Policy
# Set to "true" if you want strict CSP
ENABLE_CSP="false"

# ============================================
# NOTES
# ============================================

# 1. Never commit this file to version control
# 2. Keep your API keys secure
# 3. Use strong passwords for database
# 4. Change SECRET_KEY for production
# 5. Enable HSTS only with valid SSL certificate
